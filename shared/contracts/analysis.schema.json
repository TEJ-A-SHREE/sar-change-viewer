{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sar-change-viewer/contracts/analysis.schema.json",
  "title": "SAR Change Viewer analysis contract",
  "description": "Source of truth for the request/response shape between frontend and backend. Mirrors: frontend/src/types/analysis.ts and backend/app/models.py. Bump contractVersion in all three when changing.",
  "contractVersion": "1.1.0",
  "$defs": {
    "BBox": {
      "type": "array",
      "description": "[minLon, minLat, maxLon, maxLat] in WGS84 degrees",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "AreaOfInterest": {
      "type": "object",
      "required": ["bbox"],
      "properties": {
        "name": { "type": "string" },
        "bbox": { "$ref": "#/$defs/BBox" }
      }
    },
    "AnalysisRequest": {
      "type": "object",
      "required": ["area", "beforeDate", "afterDate"],
      "properties": {
        "area": { "$ref": "#/$defs/AreaOfInterest" },
        "beforeDate": { "type": "string", "format": "date" },
        "afterDate": { "type": "string", "format": "date" },
        "source": { "type": "string", "enum": ["nisar"], "default": "nisar" }
      }
    },
    "ImageAsset": {
      "type": "object",
      "required": ["url", "caption"],
      "properties": {
        "url": { "type": "string" },
        "caption": { "type": "string", "description": "One plain-language sentence" },
        "widthPx": { "type": "integer" },
        "heightPx": { "type": "integer" }
      }
    },
    "LegendEntry": {
      "type": "object",
      "required": ["color", "label"],
      "properties": { "color": { "type": "string" }, "label": { "type": "string" } }
    },
    "Finding": {
      "type": "object",
      "required": ["title", "description", "severity"],
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "notable", "significant"] },
        "percentOfArea": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "AnalysisResult": {
      "type": "object",
      "required": ["id", "contractVersion", "request", "images", "summary", "findings", "stats", "metadata"],
      "properties": {
        "id": { "type": "string" },
        "contractVersion": { "type": "string" },
        "request": { "$ref": "#/$defs/AnalysisRequest" },
        "images": {
          "type": "object",
          "required": ["before", "after", "change"],
          "properties": {
            "before": { "$ref": "#/$defs/ImageAsset" },
            "after": { "$ref": "#/$defs/ImageAsset" },
            "change": {
              "allOf": [
                { "$ref": "#/$defs/ImageAsset" },
                {
                  "type": "object",
                  "required": ["legend"],
                  "properties": { "legend": { "type": "array", "items": { "$ref": "#/$defs/LegendEntry" } } }
                }
              ]
            }
          }
        },
        "summary": {
          "type": "object",
          "required": ["headline", "plain", "confidence"],
          "properties": {
            "headline": { "type": "string", "maxLength": 120, "description": "<= 12 words" },
            "plain": { "type": "string", "description": "2-4 jargon-free sentences" },
            "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
          }
        },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "stats": {
          "type": "object",
          "required": ["analysedAreaKm2", "changedAreaKm2", "changedPercent", "increaseKm2", "decreaseKm2"],
          "properties": {
            "analysedAreaKm2": { "type": "number" },
            "changedAreaKm2": { "type": "number" },
            "changedPercent": { "type": "number" },
            "increaseKm2": { "type": "number" },
            "decreaseKm2": { "type": "number" }
          }
        },
        "metadata": {
          "type": "object",
          "required": ["satellite", "polarization", "processingSteps", "generatedAt", "synthetic"],
          "properties": {
            "satellite": { "type": "string" },
            "polarization": { "type": "string" },
            "processingSteps": { "type": "array", "items": { "type": "string" } },
            "generatedAt": { "type": "string", "format": "date-time" },
            "synthetic": { "type": "boolean" }
          }
        }
      }
    },
    "ApiError": {
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
        }
      }
    }
  }
}
